{
  "name": "c25-monorepo",
  "version": "1.0.0",
  "description": "C25 Constellation25 Monorepo - FacePrintPay AI Ecosystem",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/c25-agent/*",
    "packages/faceprintpay/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start": "npm run start --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "lint": "eslint packages/**/src/** apps/**/src/**",
    "format": "prettier --write \"packages/**/*.{js,ts,tsx}\" \"apps/**/*.{js,ts,tsx}\""
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "ai",
    "agent",
    "constellation25",
    "faceprintpay",
    "pathos",
    "versed"
  ],
  "author": "Cygel White / FacePrintPay",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FacePrintPay/c25-monorepo.git"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.0"
  }
}
